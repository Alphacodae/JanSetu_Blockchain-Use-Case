# Local classroom demo only; keep the API bound to loopback.
HOST=127.0.0.1
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173
RPC_URL=http://127.0.0.1:8545
DEPLOYMENT_FILE=deployment.local.json
DATABASE_FILE=data/jansetu.sqlite
SIGNER_MODE=local-hardhat

# Optional for local testing. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production deployments are intentionally disabled in this build. Supply this secret
# through a secret manager before a supported managed-signer implementation is added.
# JANSETU_HASH_KEY=
